dth": "1_2", "modules": [{"type": "blurb", "divi": "et_pb_blurb", "icon": "", "title": "Come as you are", "html": "You’ll get a warm welcome, a quick tour, and cozy comforts."}, {"type": "blurb", "divi": "et_pb_blurb", "icon": "", "title": "Share your story", "html": "We’ll listen to your health history, lifestyle, and goals, no judgment."}, {"type": "blurb", "divi": "et_pb_blurb", "icon": "", "title": "Know what’s next", "html": "We explain every step clearly, from diagnostics to treatment options."}]}]}]}, {"id": "et_pb_section_4", "bg": null, "rows": [{"id": "et_pb_row_3", "columns": [{"width": "1_5", "modules": []}, {"width": "3_5", "modules": [{"type": "text", "divi": "et_pb_text", "html": "<h2>Great care, rewarding from day one</h2><p>We’ve created a special offer to help you start your care with confidence.</p>"}]}, {"width": "1_5", "modules": []}]}, {"id": "et_pb_row_4", "columns": [{"width": "1_4", "modules": []}, {"width": "1_2", "modules": [{"type": "text", "divi": "et_pb_text", "html": "<h3>First Visit</h3>"}, {"type": "text", "divi": "et_pb_text", "html": "$99"}, {"type": "text", "divi": "et_pb_text", "html": "Your first visit includes a <a href=\"/services/dental-cleaning/\">complete exam</a>, digital X-rays, and a routine cleaning, to give us a clear picture of your oral and whole-body health.<p><strong>For new, non-insured patients.</strong></p>"}, {"type": "button", "label": "Book Your $99 Visit", "href": "https://flexbook.me/mydeardent/MDDnet", "external": true, "divi": "et_pb_button"}]}, {"width": "1_4", "modules": []}]}, {"id": "et_pb_row_5", "columns": [{"width": "1_5", "modules": []}, {"width": "3_5", "modules": [{"type": "text", "divi": "et_pb_text", "html": "Not sure where to begin? Our team is happy to help you choose the option that fits your needs."}]}, {"width": "1_5", "modules": []}]}]}, {"id": "et_pb_section_5", "bg": null, "rows": [{"id": "et_pb_row_6", "columns": [{"width": "4_4", "modules": [{"type": "text", "divi": "et_pb_text", "html": "<h2>Payment <em><strong>Made Simple</strong></em></h2>"}]}]}, {"id": "et_pb_row_7", "columns": [{"width": "1_2", "modules": [{"type": "text", "divi": "et_pb_text", "html": "<h3>No insurance? No problem</h3><p>We make it easy to say yes to care. Start with our $99 New Patient Special; it includes a full exam, routine cleaning, and our curated welcome package — thoughtfully designed to support your whole-body health at home.</p><p>Our payment options include:</p>"}, {"type": "icon_list", "divi": "dsm_icon_list", "items": [{"text": "Cash, checks, and all major credit cards", "href": null}, {"text": "Flexible financing options (CareCredit, Sunbit, Proceed Finance, and Cherry Financing)", "href": null}, {"text": "In-house membership plans", "href": null}]}]}, {"width": "1_2", "modules": [{"type": "text", "divi": "et_pb_text", "html": "<h3>We accept most major PPO insurance plans</h3>"}, {"type": "masonry_gallery", "divi": "dsm_masonry_gallery", "images": [{"src": "https://mydeardentist.net/wp-content/uploads/2025/07/aetna-2-300x57-1.png", "alt": "Aetna", "title": "aetna-2-300×57-1"}, {"src": "https://mydeardentist.net/wp-content/uploads/2025/07/anthem-blue-cross-blueshield-300x70-1.jpg", "alt": "Anthem", "title": "anthem-blue-cross-blueshield-300×70-1"}, {"src": "https://mydeardentist.net/wp-content/uploads/2025/07/careington-1-300x73-1.png", "alt": "Careington", "title": "careington-1-300×73-1"}, {"src": "https://mydeardentist.net/wp-content/uploads/2025/07/delta-dental-2-300x74-1.jpg", "alt": "Delta Dental", "title": "delta-dental-2-300×74-1"}, {"src": "https://mydeardentist.net/wp-content/uploads/2025/07/lincoln_national_corporation_logo-300x98-1.png", "alt": "Lincoln Financial Group", "title": "lincoln_national_corporation_logo-300×98-1"}, {"src": "https://mydeardentist.net/wp-content/uploads/2025/07/metlife-2-300x68-1.jpg", "alt": "Metlife", "title": "metlife-2-300×68-1"}, {"src": "https://mydeardentist.net/wp-content/uploads/2025/07/united-healthcare-1-300x88-1.jpg", "alt": "United Healthcare", "title": "united-healthcare-1-300×88-1"}, {"src": "https://mydeardentist.net/wp-content/uploads/2025/07/guardian-1.jpg", "alt": "Guardian", "title": "guardian-1"}, {"src": "https://mydeardentist.net/wp-content/uploads/2025/07/geha-logo-300x74-1.png", "alt": "Geha", "title": "geha-logo-300×74-1"}, {"src": "https://mydeardentist.net/wp-content/uploads/2025/07/blue-cross-blue-shield-logo-300x167-1-e1753728876968.jpg", "alt": "BlueCross", "title": "blue-cross-blue-shield-logo-300×167-1"}, {"src": "https://mydeardentist.net/wp-content/uploads/2025/07/united-concordia-1-300x72-1.jpg", "alt": "United Concordia", "title": "united-concordia-1-300×72-1"}, {"src": "https://mydeardentist.net/wp-content/uploads/2025/07/cigna-2-e1753728957588.jpg", "alt": "Cigna", "title": "cigna-2"}, {"src": "https://mydeardentist.net/wp-content/uploads/2025/08/sunlife.webp", "alt": "", "title": "sunlife"}, {"src": "https://mydeardentist.net/wp-content/uploads/2025/08/zelis.webp", "alt": "", "title": "zelis"}, {"src": "https://mydeardentist.net/wp-content/uploads/2025/08/principal.webp", "alt": "", "title": "principal"}, {"src": "https://mydeardentist.net/wp-content/uploads/2025/08/ameritas.webp", "alt": "", "title": "ameritas"}]}]}]}, {"id": "et_pb_row_8", "columns": [{"width": "4_4", "modules": [{"type": "text", "divi": "et_pb_text", "html": "Not sure if you’re covered? Call us at <a href=\"tel:2816531818\">(281) 653-1818</a>; we’ll check your benefits and explain your options. No stress. No surprises."}]}]}]}, {"id": "et_pb_section_6", "bg": null, "rows": [{"id": "et_pb_row_9", "columns": [{"width": "1_3", "modules": [{"type": "text", "divi": "et_pb_text", "html": "<h2>Our Membership Club</h2><p>Our in-house Membership Club is a simple way to keep your smile healthy all year long with predictable costs and exclusive member benefits.</p>"}, {"type": "button", "label": "Book Online", "href": "https://flexbook.me/mydeardent/MDDnet", "external": true, "divi": "et_pb_button"}]}, {"width": "1_3", "modules": [{"type": "text", "divi": "et_pb_text", "html": "<h2>How it works</h2><p>Join once and enjoy instant savings! Your one-time $99 activation fee covers your first month, and after that, you’ll pay a low monthly fee. No deductibles, no yearly maximums, and no surprise bills.</p>"}]}, {"width": "1_3", "modules": [{"type": "text", "divi": "et_pb_text", "html": "<h4>Every plan includes:</h4><ul><li>Professional cleanings (up to 3/year)</li><li>Comprehensive exams and X-rays</li><li>One emergency visit per year (if needed)</li><li>Exclusive member discounts on additional treatments</li><li>Free Invisalign consultation with free smile design</li><li>Free sleep apnea screening</li><li>15% off all other treatments (exclusions apply)</li></ul>"}]}]}]}, {"id": "et_pb_section_7", "bg": null, "rows": [{"id": "et_pb_row_10", "columns": [{"width": "1_5", "modules": []}, {"width": "3_5", "modules": [{"type": "text", "divi": "et_pb_text", "html": "<h2>Choose the plan that fits you</h2>"}]}, {"width": "1_5", "modules": []}]}, {"id": "et_pb_row_11", "columns": [{"width": "1_3", "modules": [{"type": "text", "divi": "et_pb_text", "html": "<strong>Child Membership — $25/month</strong><p>For kids 12 and under. Includes cleanings, exams, and emergency care.</p>"}]}, {"width": "1_3", "modules": [{"type": "text", "divi": "et_pb_text", "html": "<strong>Adult Membership — $30/month</strong><p>For ages 13 and older. Everything you need for preventive and routine care.</p>"}]}, {"width": "1_3", "modules": [{"type": "text", "divi": "et_pb_text", "html": "<strong>Perio Membership — $48/month<br/></strong><p>For patients with periodontal (gum) needs. Includes extra maintenance cleanings and ongoing support to protect your oral and overall health.<br/></p>"}]}]}, {"id": "et_pb_row_12", "columns": [{"width": "4_4", "modules": [{"type": "text", "divi": "et_pb_text", "html": "All memberships include a one-time $99 lifetime activation fee."}]}]}]}, {"id": "et_pb_section_8", "bg": null, "rows": [{"id": "et_pb_row_13", "columns": [{"width": "1_2", "modules": [{"type": "image", "divi": "et_pb_image", "src": "https://mydeardentist.net/wp-content/uploads/2026/04/my-dear-dentist-office-12.jpg", "alt": "General Dentistry at My Dear Dentist"}]}, {"width": "1_2", "modules": [{"type": "text", "divi": "et_pb_text", "html": "<h2>Why patients love our membership</h2><ul><li>No deductibles or yearly maximums</li><li>No claims or waiting periods</li><li>No pre-authorization headaches</li><li>Significant savings on every visit</li><li>Peace of mind for your whole family</li></ul><p><strong>Our Membership Club gives you freedom, flexibility, and the confidence of knowing your smile is cared for year-round.</strong></p>"}]}]}]}, {"id": "et_pb_section_10", "bg": null, "rows": [{"id": "et_pb_row_14", "columns": [{"width": "1_2", "modules": [{"type": "text", "divi": "et_pb_text", "html": "<p>“At My Dear Dentist, everything we do comes from a place of love: for our patients, our craft, and our community. As a husband-and-wife team, we’ve created a space where you feel truly cared for, seen, and supported like family.”</p>"}, {"type": "text", "divi": "et_pb_text", "html": "<p>– Dr. Shinta &amp; Dr. Amin</p>"}]}, {"width": "1_2", "modules": [{"type": "text", "divi": "et_pb_text", "html": "<h2>Smiles made <em><strong>with heart</strong></em></h2>"}, {"type": "text", "divi": "et_pb_text", "html": "<p>Straight from your dentists, Dr. Amin and Dr. Shinta</p>"}]}]}]}, {"id": "et_pb_section_11", "bg": null, "rows": [{"id": "et_pb_row_15", "columns": [{"width": "4_4", "modules": [{"type": "text", "divi": "et_pb_text", "html": "<h2>Why patients choose us</h2>"}]}]}, {"id": "et_pb_row_16", "columns": [{"width": "1_2", "modules": [{"type": "text", "divi": "et_pb_text", "html": "<h3>Cozy Comforts</h3>"}, {"type": "text", "divi": "et_pb_text", "html": "Blankets, headphones, and streaming TV to help you feel relaxed and at home."}]}, {"width": "1_2", "modules": [{"type": "text", "divi": "et_pb_text", "html": "<h3>Same Trusted Faces</h3>"}, {"type": "text", "divi": "et_pb_text", "html": "Continuity of care from a husband-and-wife team who truly know you."}]}]}, {"id": "et_pb_row_17", "columns": [{"width": "1_2", "modules": [{"type": "text", "divi": "et_pb_text", "html": "<h3>Personalized Wellness Care</h3>"}, {"type": "text", "divi": "et_pb_text", "html": "We connect oral health to sleep, nutrition, and your overall well-being."}]}, {"width": "1_2", "modules": [{"type": "text", "divi": "et_pb_text", "html": "<h3>State-of-the-Art Technology</h3>"}, {"type": "text", "divi": "et_pb_text", "html": "Digital diagnostics and advanced tools for accurate, comfortable, efficient care."}]}]}]}, {"id": "et_pb_section_13", "bg": null, "rows": [{"id": "et_pb_row_18", "columns": [{"width": "1_5", "modules": []}, {"width": "3_5", "modules": [{"type": "text", "divi": "et_pb_text", "html": "<h2>How we help you</h2>"}]}, {"width": "1_5", "modules": []}]}, {"id": "et_pb_row_19", "columns": [{"width": "1_3", "modules": [{"type": "icon", "divi": "et_pb_icon", "icon": ""}, {"type": "text", "divi": "et_pb_text", "html": "<h3>Keep your teeth healthy</h3>"}]}, {"width": "1_3", "modules": [{"type": "icon", "divi": "et_pb_icon", "icon": ""}, {"type": "text", "divi": "et_pb_text", "html": "<h3>Enhance your smile</h3>"}]}, {"width": "1_3", "modules": [{"type": "icon", "divi": "et_pb_icon", "icon": ""}, {"type": "text", "divi": "et_pb_text", "html": "<h3>Sleep better, live better</h3>"}]}]}]}, {"id": "et_pb_section_14", "bg": null, "rows": [{"id": "et_pb_row_20", "columns": [{"width": "4_4", "modules": [{"type": "text", "divi": "et_pb_text", "html": "<h2>Get ready for <em><strong>your first visit</strong></em></h2>"}]}]}, {"id": "et_pb_row_21", "columns": [{"width": "1_2", "modules": [{"type": "blurb", "divi": "et_pb_blurb", "icon": "", "title": "What you’ll get at your first visit", "html": "<ul><li>A real conversation about your health, history, and goals</li><li>Full-mouth digital X-rays and a panoramic scan</li><li>Intraoral photos and a thorough gum health check</li><li>Complete dental exam — teeth, gums, bite, jaw, and more</li><li>A gentle, routine cleaning (unless a deep cleaning is needed)</li><li>A personalized care plan with clear pricing and no pressure</li></ul>"}]}, {"width": "1_2", "modules": [{"type": "blurb", "divi": "et_pb_blurb", "icon": "", "title": "What to bring", "html": "<ul><li>Photo ID</li><li>Insurance card (if applicable)</li><li>List of current medications</li><li>Any past dental records or X-rays (if available)</li><li>Your questions, concerns, or smile goals — we’re here to listen</li><li>A favorite playlist if you’d like to bring your own headphones (we also have some!)</li></ul>"}]}]}]}, {"id": "et_pb_section_16", "bg": null, "rows": [{"id": "et_pb_row_22", "columns": [{"width": "4_4", "modules": [{"type": "text", "divi": "et_pb_text", "html": "<h2>Ready to <strong><em>love</em></strong> your smile?</h2><p>Experience whole-body care from a team that treats you like family. Book your visit today!</p>"}, {"type": "button", "label": "Book Online", "href": "https://flexbook.me/mydeardent/MDDnet", "external": true, "divi": "et_pb_button"}]}]}]}, {"id": "et_pb_section_17", "bg": null, "rows": [{"id": "et_pb_row_23", "columns": [{"width": "4_4", "modules": [{"type": "image_carousel", "divi": "dsm_image_carousel", "images": [{"src": "https://mydeardentist.net/wp-content/uploads/2026/04/my-dear-dentist-office-12.jpg", "alt": "", "title": "my-dear-dentist-office-12"}, {"src": "https://mydeardentist.net/wp-content/uploads/2026/04/my-dear-dentist-office-11.jpg", "alt": "", "title": "my-dear-dentist-office-11"}, {"src": "https://mydeardentist.net/wp-content/uploads/2026/04/my-dear-dentist-office-10.jpg", "alt": "", "title": "my-dear-dentist-office-10"}, {"src": "https://mydeardentist.net/wp-content/uploads/2026/04/my-dear-dentist-office-9.jpg", "alt": "", "title": "my-dear-dentist